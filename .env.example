# Copy to .env (gitignored) for docker compose. Never commit the real file.
# The OAuth web client ID from the dev project (Google Auth Platform -> Clients). Not secret.
GOOGLE_CLIENT_ID=
# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=
# Host ports, if something else already uses the defaults.
# DB_PORT=5432
# API_PORT=8000
# WEB_PORT=5173
